# คัดลอกเป็น .env.local แล้วใส่คีย์ตัวใดตัวหนึ่ง — ไม่ใส่เลยก็รันได้ (โหมดสาธิต)
# ต้อง restart dev server หลังแก้ไฟล์นี้

# Gemini — คีย์แบบไม่เสียเงินใช้ได้กับการสาธิตด้วยบทสนทนาที่แต่งขึ้นเท่านั้น
# ห้ามใช้กับนักเรียนจริง: ข้อความถูกนำไปพัฒนาผลิตภัณฑ์และอาจมีคนอ่าน (ดู README หัวข้อ "ผู้ให้บริการ AI เก็บอะไร")
GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-3.5-flash
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite

# หรือ Claude
ANTHROPIC_API_KEY=

# บังคับโหมดสาธิตแม้จะมีคีย์ (วันเดโมถ้าเน็ตหรือ API ไม่นิ่ง)
# FORCE_DEMO=1

# เตือนพักเมื่อคุยต่อเนื่องเกินกี่นาที (ค่าเริ่มต้น 30)
# NEXT_PUBLIC_BREAK_MINUTES=30

# ที่เก็บข้อมูล — ไม่ใส่ = memory (พอสำหรับ dev) · บน Vercel ต่อ Neon แล้ว env นี้ถูกใส่ให้เอง
# DATABASE_URL=
